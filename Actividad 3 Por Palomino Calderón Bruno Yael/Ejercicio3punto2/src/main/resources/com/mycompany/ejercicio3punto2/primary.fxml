<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio3punto2.PrimaryController">
    <children>
        <Label text="Fábulas gráficas de Esopo" style="-fx-font-weight: bold;"/>
        <Label text="La Liebre y la Tortuga" />
        <Button fx:id="btnIniciar" text="¡Inicio de Carrera!" onAction="#iniciarCarrera" />

        <VBox alignment="CENTER_LEFT" spacing="5.0" maxWidth="300">
            <children>
                <Label fx:id="lblEstadoLiebre" text="La Liebre:" />
                <ProgressBar fx:id="barraLiebre" progress="0.0" prefWidth="300" />
            </children>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="5.0" maxWidth="300">
            <children>
                <Label fx:id="lblEstadoTortuga" text="La Tortuga:" />
                <ProgressBar fx:id="barraTortuga" progress="0.0" prefWidth="300" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
